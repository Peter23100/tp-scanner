# RIGHT SCREEN: hold and breakout families (master §4.11–§4.26). 14 of 16.
#
# NOT HERE: Breakout_Hold_Up / Breakout_Hold_Down (§4.25–§4.26). The master describes them but
# doesn't quote the expression, and a transcription from prose is exactly the invisible-threshold
# risk the export exists to avoid. Paste the verbatim expression to add them.

# §4.11 Spiked hard on volume in a completed five-minute bar, then gave none of it back.
# Peter's best-performing setup. Three magnitude floors on the spike bar (dollar, percent, ATR)
# and three retention clauses (0.25 / 0.25 / 0.50).
trigger M_Spike_Hold_Up {
    side long
    screen right
    cooldown 5m
    when day_volume >= 250_000
     and last >= 2
     and atr / prev_close >= 0.025
     and last >= prev_close
     and RVOL20DAYTIMEADJUSTED >= 1.25
     and spike_range >= 0.50
     and spike_range >= last * 0.025
     and spike_range / atr >= 0.40
     and (volume(5m, 1) >= volume(5m, 2) * 1.25 or volume(5m, 1) >= adv * 0.03)
     and low(1m, 1) >= high(5m, 1) - spike_range * 0.25
     and last >= high(5m, 1) - spike_range * 0.25
     and low(5m) >= high(5m, 1) - spike_range * 0.50
}

# §4.12 Exact mirror of §4.11: retention measured from the spike bar's low upward.
trigger M_Spike_Hold_Down {
    side short
    screen right
    cooldown 5m
    when day_volume >= 250_000
     and last >= 2
     and atr / prev_close >= 0.025
     and last <= prev_close
     and RVOL20DAYTIMEADJUSTED >= 1.25
     and spike_range >= 0.50
     and spike_range >= last * 0.025
     and spike_range / atr >= 0.40
     and (volume(5m, 1) >= volume(5m, 2) * 1.25 or volume(5m, 1) >= adv * 0.03)
     and high(1m, 1) <= low(5m, 1) + spike_range * 0.25
     and last <= low(5m, 1) + spike_range * 0.25
     and high(5m) <= low(5m, 1) + spike_range * 0.50
}

# §4.13 A sustained fifteen-minute run that price is still holding near the top of.
# Previous-generation design (ELVA, no burst leg); translated as loaded. On rolling windows the
# forming-bar coil clause `high(1m) - low(1m)` measures the last full minute, not a bar that
# restarts from zero, so the §4.13 "passes automatically" defect doesn't carry over.
trigger M_Run_Hold_Up {
    side long
    screen right
    cooldown 5m
    when day_volume >= 250_000
     and last >= 2
     and RVOL20DAYTIMEADJUSTED >= 1.25
     and day_range >= 0.50
     and (high(15m) - low(15m)) / atr >= 0.60
     and (high(15m) - low(15m)) >= 0.50
     and (high(15m) - low(15m)) / day_range >= 0.15
     and (volume(15m) >= volume(15m, 1) * 2.0 or volume(15m) >= adv * 0.077)
     and last >= prev_close
     and last >= high(15m) - (high(15m) - low(15m)) * 0.25
     and (high(1m) - low(1m)) / atr <= 0.25
     and (high(1m, 1) - low(1m, 1)) / atr <= 0.25
     and last >= vwap
}

# §4.14 Exact mirror of §4.13.
trigger M_Run_Hold_Down {
    side short
    screen right
    cooldown 5m
    when day_volume >= 250_000
     and last >= 2
     and RVOL20DAYTIMEADJUSTED >= 1.25
     and day_range >= 0.50
     and (high(15m) - low(15m)) / atr >= 0.60
     and (high(15m) - low(15m)) >= 0.50
     and (high(15m) - low(15m)) / day_range >= 0.15
     and (volume(15m) >= volume(15m, 1) * 2.0 or volume(15m) >= adv * 0.077)
     and last <= prev_close
     and last <= low(15m) + (high(15m) - low(15m)) * 0.25
     and (high(1m) - low(1m)) / atr <= 0.25
     and (high(1m, 1) - low(1m, 1)) / atr <= 0.25
     and last <= vwap
}

# §4.15 A liquid large-cap breaking above yesterday's high to a new high of day, in an uptrend,
# not yet extended from VWAP. Carries the set's only anti-chase clause (VWAP + 1 ATR cap).
trigger M3_Breakout_Long {
    side long
    screen right
    cooldown 1m
    when last >= 20
     and last < 600
     and adv >= 2_000_000
     and RVOL20DAYTIMEADJUSTED >= 2.0
     and (last - prev_close) / atr >= 0.5
     and (last - prev_close) >= last * 0.01
     and atr / last <= 0.15
     and day_range >= 0.50
     and last >= prev_high
     and last >= day_high
     and up15 / atr >= 0.30
     and up15 / day_range >= 0.15
     and last >= vwap
     and last <= vwap + 1.0 * atr
     and ema(5m, 7) >= ema(5m, 20)
     and volume(5m) >= volume(5m, 1) * 1.5
     and new_high(5m)
}

# §4.16 Exact mirror of §4.15, including the cap at VWAP − 1 ATR.
trigger M4_Breakdown_Short {
    side short
    screen right
    cooldown 1m
    when last >= 20
     and last < 600
     and adv >= 2_000_000
     and RVOL20DAYTIMEADJUSTED >= 2.0
     and (prev_close - last) / atr >= 0.5
     and (prev_close - last) >= last * 0.01
     and atr / last <= 0.15
     and day_range >= 0.50
     and last <= prev_low
     and last <= day_low
     and dn15 / atr >= 0.30
     and dn15 / day_range >= 0.15
     and last <= vwap
     and last >= vwap - 1.0 * atr
     and ema(5m, 7) <= ema(5m, 20)
     and volume(5m) >= volume(5m, 1) * 1.5
     and new_low(5m)
}

# §4.17 Pullback to the 5-minute EMA7 in an uptrend, now taking out the pullback bar's high.
# 10:00–15:20 only.
trigger M5_Pullback_Long {
    side long
    screen right
    cooldown 5m
    when last >= 20
     and last < 600
     and adv >= 2_000_000
     and RVOL20DAYTIMEADJUSTED >= 2.0
     and time >= 10:00
     and time <= 15:20
     and last >= prev_close * 1.03
     and high(30m) >= prev_high * 0.97
     and last >= vwap
     and last <= vwap * 1.04
     and ema(5m, 7) >= ema(5m, 20)
     and low(5m, 1) <= ema(5m, 7) * 1.01
     and low(5m, 1) >= ema(5m, 7) * 0.97
     and last >= high(5m, 1)
     and volume(5m) >= volume(5m, 1) * 1.2
}

# §4.18 Mirror of §4.17. ⚠ Built from the master's description ("prior bar's high between 0.99×
# and 1.03× of EMA7, then Last <= MinuteLow(5,P1); same window, same 1.2 multiple, same
# percentage VWAP cap"); the day-move, 30-minute and VWAP-cap constants are mirrored from §4.17
# (0.97 / 1.03 / 0.96). Confirm against the pasted expression.
trigger M6_Bounce_Short {
    side short
    screen right
    cooldown 5m
    when last >= 20
     and last < 600
     and adv >= 2_000_000
     and RVOL20DAYTIMEADJUSTED >= 2.0
     and time >= 10:00
     and time <= 15:20
     and last <= prev_close * 0.97
     and low(30m) <= prev_low * 1.03
     and last <= vwap
     and last >= vwap * 0.96
     and ema(5m, 7) <= ema(5m, 20)
     and high(5m, 1) >= ema(5m, 7) * 0.99
     and high(5m, 1) <= ema(5m, 7) * 1.03
     and last <= low(5m, 1)
     and volume(5m) >= volume(5m, 1) * 1.2
}

# §4.19 An orderly uptrend, higher highs and higher lows, fully stacked above its averages.
# Alignment, not magnitude.
trigger M7_GrindUp {
    side long
    screen right
    cooldown 10m
    when day_volume >= 750_000
     and last >= 5
     and RVOL20DAYTIMEADJUSTED >= 1.5
     and last >= prev_close * 1.02
     and last >= vwap
     and low(5m, 1) >= vwap
     and ema(5m, 7) >= ema(5m, 20)
     and last >= ema(5m, 20)
     and last >= daily_ema(20)
     and high(5m, 1) >= high(5m, 3)
     and low(5m, 1) >= low(5m, 3)
     and new_high(5m)
}

# §4.20 Exact mirror of §4.19.
trigger M8_GrindDown {
    side short
    screen right
    cooldown 10m
    when day_volume >= 750_000
     and last >= 5
     and RVOL20DAYTIMEADJUSTED >= 1.5
     and last <= prev_close * 0.98
     and last <= vwap
     and high(5m, 1) <= vwap
     and ema(5m, 7) <= ema(5m, 20)
     and last <= ema(5m, 20)
     and last <= daily_ema(20)
     and high(5m, 1) <= high(5m, 3)
     and low(5m, 1) <= low(5m, 3)
     and new_low(5m)
}

# §4.21 A low-float stock up big and breaking to new highs on heavy volume. No base: the
# parabolic runner filter. Primus `FloatShares <= 20` is millions.
trigger LowFloat_HOD_Break_Up {
    side long
    screen right
    cooldown 5m
    when float <= 20_000_000
     and prev_close >= 0.25
     and prev_close <= 50
     and day_volume_ext >= 250_000
     and (last - prev_close) / prev_close >= 0.10
     and last >= day_high - 0.15 * atr
     and (RVOL20DAYTIMEADJUSTED >= 3.0 or volume(5m) * 24 >= volume(120m) * 3.0)
     and (volume(5m, 1) >= volume(5m, 2) * 1.5 or volume(5m, 1) >= adv * 0.05)
     and new_high(5m)
}

# §4.22 A liquid stock breaking out of a tight 30-minute base near the highs to a new high of day,
# on heavy volume. The set's only genuine break margin (base high + 0.15 ATR); volume is AND.
trigger HOD_Base_Break_LQ {
    side long
    screen right
    cooldown 5m
    when day_volume >= 500_000
     and last >= prev_close * 1.05
     and day_range >= last * 0.03
     and (RVOL20DAYTIMEADJUSTED >= 2.0 or volume(5m) * 24 >= volume(120m) * 3.0)
     and ema(5m, 7) >= ema(5m, 20)
     and (high(30m, 1) - low(30m, 1)) / day_range <= 0.20
     and high(30m, 1) >= day_high - 0.25 * day_range
     and last >= high(30m, 1) + 0.15 * atr
     and last >= day_high
     and volume(5m) >= volume(5m, 1) * 1.5
     and volume(5m) >= adv * 0.03
     and new_high(5m)
}

# §4.23 M_Spike_Hold tightened, plus a first-time-today break of last month's high.
trigger Base_Break_Hold_Up {
    side long
    screen right
    cooldown 15m
    when day_volume >= 500_000
     and last >= 5
     and atr / prev_close >= 0.025
     and RVOL20DAYTIMEADJUSTED >= 2.0
     and last >= prev_close * 1.03
     and day_low >= prev_close
     and last >= prev_month_high
     and prev_close < prev_month_high
     and spike_range >= 0.50
     and spike_range >= last * 0.035
     and spike_range / atr >= 0.60
     and (volume(5m, 1) >= volume(5m, 2) * 1.5 or volume(5m, 1) >= adv * 0.05)
     and (high(1m, 1) - low(1m, 1)) / atr <= 0.20
     and (high(1m, 2) - low(1m, 2)) / atr <= 0.20
     and low(1m, 1) >= high(5m, 1) - spike_range * 0.25
     and last >= high(5m, 1) - spike_range * 0.25
     and low(5m) >= high(5m, 1) - spike_range * 0.50
}

# §4.24 Exact mirror of §4.23, with the flips the master lists.
trigger Base_Break_Hold_Down {
    side short
    screen right
    cooldown 15m
    when day_volume >= 500_000
     and last >= 5
     and atr / prev_close >= 0.025
     and RVOL20DAYTIMEADJUSTED >= 2.0
     and last <= prev_close * 0.97
     and day_high <= prev_close
     and last <= prev_month_low
     and prev_close > prev_month_low
     and spike_range >= 0.50
     and spike_range >= last * 0.035
     and spike_range / atr >= 0.60
     and (volume(5m, 1) >= volume(5m, 2) * 1.5 or volume(5m, 1) >= adv * 0.05)
     and (high(1m, 1) - low(1m, 1)) / atr <= 0.20
     and (high(1m, 2) - low(1m, 2)) / atr <= 0.20
     and high(1m, 1) <= low(5m, 1) + spike_range * 0.25
     and last <= low(5m, 1) + spike_range * 0.25
     and high(5m) <= low(5m, 1) + spike_range * 0.50
}
